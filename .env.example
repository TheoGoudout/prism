# Copy this file to .env and fill in the values.
# Never commit .env — it contains secrets.

# Local development settings. Production runs on Coolify, which takes its
# variables from its own Environment Variables tab — see deployment.md.

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Prism"

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"
SECRET_KEY=changethis            # Generate with: openssl rand -hex 32
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Public URL of the backend API (used to build OAuth callback URIs)
# In production set this to your real domain, e.g. https://api.example.com
API_BASE_URL=http://localhost:8000

# Emails (optional — leave blank to disable email sending)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0
# Celery worker processes
CELERY_CONCURRENCY=2

# Sentry error tracking (optional)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# OAuth2 platform credentials
# Register your app on each platform's developer portal to obtain these.
# All fields are optional — only fill in the platforms you want to support.
# A platform is available only once both its values are set; the API and the
# worker log which platform integrations are activated on startup.
# ---------------------------------------------------------------------------

# Facebook (Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram (Instagram Login): the Instagram app ID and secret of the Meta app,
# under Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Twitter / X — https://developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google (Analytics OAuth) — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI / LangChain
# Set AI_PROVIDER to one of: openai, anthropic, google
# Only the API key for the chosen provider needs to be filled in.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith tracing (optional — leave blank to disable)
# Sign up at https://smith.langchain.com to get an API key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prism
# Use https://eu.api.smith.langchain.com for the EU region
LANGCHAIN_ENDPOINT=
