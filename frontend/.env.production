# Loaded by `vite build` (production mode), on top of frontend/.env.
# Public values only — anything in a VITE_* variable is inlined into the
# client bundle.
#
# Inline environment variables still win over this file, so the Docker image
# build (`--build-arg VITE_API_URL=...`) keeps overriding it.
VITE_API_URL=https://api.prism.ai
