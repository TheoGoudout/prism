{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production only: there is no staging environment, so the top-level
  // configuration is what deploys. See deployment.md.
  "name": "prism-frontend",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links such as /analytics must resolve to the SPA shell.
    "not_found_handling": "single-page-application"
  },
  // No `routes` key: the custom domain (app.prism.ai) is attached by hand in
  // the Cloudflare dashboard. Declaring it here would make wrangler reconcile
  // it against the zone on *every* deploy, which needs a CI token carrying
  // Workers Routes: Edit and DNS: Edit on the zone — enough to repoint
  // api.prism.ai if the token ever leaked. Leaving it out keeps the token
  // account-scoped.
  //
  // The trade-off: renaming `name` silently orphans the dashboard binding.
  "workers_dev": false
}
